# SlickTrace Environment Configuration
PROJECT_NAME="SlickTrace - Marine Oil Spill Detection & Vessel Attribution System"
API_V1_STR="/api/v1"
SECRET_KEY="national-maritime-defense-secret-key-change-in-production"

# Database Configuration (SQLite default for zero-config local testing, PostgreSQL+PostGIS in production)
DATABASE_URL="sqlite:///./slicktrace.db"

# Celery & Redis Task Queue Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Media Storage
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"

# =====================================================================
# Feature 2 Configuration - Real Environmental Data Sources (Option A)
# =====================================================================

# 1. Copernicus Marine Service (CMEMS) - Ocean Currents (Hydrodynamics)
# Register at: https://marine.copernicus.eu/
CMEMS_USERNAME=
CMEMS_PASSWORD=

# 2. Copernicus Climate Data Store (CDS) - ERA5 Surface Wind (Meteorology)
# Register at: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=b5ecf3a2-58d4-4023-b264-63cdf10b5c06

# 3. Active Environmental Providers
FEATURE2_ENVIRONMENT=development
FEATURE2_CURRENTS_PROVIDER=mock
FEATURE2_WIND_PROVIDER=mock
FEATURE2_FORECAST_CURRENTS_PROVIDER=mock
FEATURE2_FORECAST_WIND_PROVIDER=mock

# 4. NOAA GFS Operational Forecast Endpoint (Surface Wind Forecast)
GFS_ENDPOINT_URL=https://api.open-meteo.com/v1/gfs

# 5. Local Environmental Data Cache Directory
DATA_CACHE_DIR=./data_cache
FEATURE2_LOG_LEVEL=INFO
