# SlickTrace Environment Configuration
PROJECT_NAME="SlickTrace - Marine Oil Spill Detection & Vessel Attribution System"
API_V1_STR="/api/v1"
SECRET_KEY="national-maritime-defense-secret-key-change-in-production"

# Database Configuration (SQLite default for zero-config local testing, PostgreSQL+PostGIS in production)
DATABASE_URL="sqlite:///./slicktrace.db"

# Celery & Redis Task Queue Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Media Storage
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"

# Feature 2 Configuration - Oil Spill Origin Tracing & Trajectory Forecasting
CMEMS_USERNAME=
CMEMS_PASSWORD=
CDSAPI_URL=
CDSAPI_KEY=

ERA5_WIND_DATA_PATH=
COPERNICUS_CURRENTS_DATA_PATH=
COPERNICUS_FORECAST_CURRENTS_DATA_PATH=
GFS_WIND_DATA_PATH= 

FEATURE2_ENVIRONMENT=development
FEATURE2_CURRENTS_PROVIDER=mock
FEATURE2_WIND_PROVIDER=mock
FEATURE2_FORECAST_CURRENTS_PROVIDER=mock
FEATURE2_FORECAST_WIND_PROVIDER=mock

GFS_ENDPOINT_URL=https://api.open-meteo.com/v1/gfs
DATA_CACHE_DIR=./data_cache
FEATURE2_LOG_LEVEL=INFO

# Frontend CARTO Basemaps API Key
VITE_CARTO_API_KEY=
